release/moc_MainWindow.o: release/moc_MainWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_MainWindow.o release/moc_MainWindow.cpp

release/moc_ClipDialog.o: release/moc_ClipDialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_ClipDialog.o release/moc_ClipDialog.cpp

release/moc_TimeEditWidget.o: release/moc_TimeEditWidget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_TimeEditWidget.o release/moc_TimeEditWidget.cpp

release/moc_ClipExtractor.o: release/moc_ClipExtractor.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_ClipExtractor.o release/moc_ClipExtractor.cpp

release/moc_VideoPlayerWidget.o: release/moc_VideoPlayerWidget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_VideoPlayerWidget.o release/moc_VideoPlayerWidget.cpp

release/moc_VideoPlayerThread.o: release/moc_VideoPlayerThread.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_VideoPlayerThread.o release/moc_VideoPlayerThread.cpp

####### Install

install_target: first FORCE
	@test -d D:$(INSTALL_ROOT:@msyshack@%=%)/workspace/BfPlayer/bin || mkdir -p D:$(INSTALL_ROOT:@msyshack@%=%)/workspace/BfPlayer/bin
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT:@msyshack@%=%)/workspace/BfPlayer/bin/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT:@msyshack@%=%)/workspace/BfPlayer/bin/$(TARGET)
	-$(DEL_DIR) D:$(INSTALL_ROOT:@msyshack@%=%)/workspace/BfPlayer/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

